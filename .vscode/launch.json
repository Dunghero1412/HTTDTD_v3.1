{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32 (Cortex-Debug + ST-Link)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}/STM32F407VET6",
      "executable": "${workspaceFolder}/STM32F407VET6/build/tdoa_f407.elf",
      "servertype": "stlink",
      "device": "STM32F407VE",
      "interface": "swd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build: STM32"
    },
    {
      "name": "Debug Controller (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/controller/controller",
      "args": [],
      "cwd": "${workspaceFolder}/controller",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "preLaunchTask": "Build: Controller",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    },
    {
      "name": "Attach OpenOCD (STM32)",
      "type": "cortex-debug",
      "request": "attach",
      "cwd": "${workspaceFolder}/STM32F407VET6",
      "executable": "${workspaceFolder}/STM32F407VET6/build/tdoa_f407.elf",
      "servertype": "openocd",
      "configFiles": [
        "interface/stlink.cfg",
        "target/stm32f4x.cfg"
      ],
      "device": "STM32F407VE",
      "runToEntryPoint": "main"
    }
  ]
}
