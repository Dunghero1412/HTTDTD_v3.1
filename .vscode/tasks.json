{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build: All",
      "type": "shell",
      "command": "make",
      "args": [],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: STM32",
      "type": "shell",
      "command": "make",
      "args": ["-C", "STM32F407VET6"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: Controller",
      "type": "shell",
      "command": "make",
      "args": ["-C", "controller"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Build: Node",
      "type": "shell",
      "command": "make",
      "args": ["-C", "tdoa_node"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean: All",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    },
    {
      "label": "Flash: STM32 (ST-Link)",
      "type": "shell",
      "command": "make",
      "args": ["-C", "STM32F407VET6", "flash"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "dependsOn": ["Build: STM32"],
      "problemMatcher": []
    },
    {
      "label": "Check: Toolchain",
      "type": "shell",
      "command": "make",
      "args": ["-C", "STM32F407VET6", "check-tools"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "none",
      "problemMatcher": []
    }
  ]
}
