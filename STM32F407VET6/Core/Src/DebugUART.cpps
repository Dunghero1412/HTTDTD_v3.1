#include "DebugUART.hpp"
#include <cstring>
#include <cstdio>

UART_HandleTypeDef* DebugUART::s_uart = nullptr;
bool DebugUART::s_fileEnabled = true;
size_t DebugUART::s_fileSize = 0;
char DebugUART::s_temp[DebugUART::kTempBufSize] = {0};
char DebugUART::s_fileBuffer[DebugUART::kMaxFileBytes + 1] = {0};

void DebugUART::init(UART_HandleTypeDef* huart) {
    s_uart = huart;
    s_fileSize = 0;
    s_fileEnabled = true;
}

void DebugUART::setFileBufferEnabled(bool enabled) {
    s_fileEnabled = enabled;
}

void DebugUART::log(const char* format, ...) {
    va_list args;
    va_start(args, format);
    int len = vsnprintf(s_temp, sizeof(s_temp), format, args);
    va_end(args);

    if (len < 0) {
        return;
    }

    size_t writeLen = (size_t)len;
    if (writeLen >= sizeof(s_temp)) {
        writeLen = sizeof(s_temp) - 1;
    }

    writeUart(s_temp, writeLen);
    storeText(s_temp, writeLen);
}

void DebugUART::logRaw(const char* text) {
    if (!text) {
        return;
    }
    size_t len = strlen(text);
    writeUart(text, len);
    storeText(text, len);
}

void DebugUART::writeUart(const char* data, size_t len) {
    if (s_uart == nullptr || len == 0) {
        return;
    }
    HAL_UART_Transmit(s_uart, reinterpret_cast<uint8_t*>(const_cast<char*>(data)), (uint16_t)len, HAL_MAX_DELAY);
}

void DebugUART::storeText(const char* text, size_t len) {
    if (!s_fileEnabled || len == 0 || s_fileSize >= kMaxFileBytes) {
        return;
    }

    size_t remaining = kMaxFileBytes - s_fileSize;
    if (remaining == 0) {
        return;
    }

    size_t copyLen = len;
    if (copyLen > remaining) {
        copyLen = remaining;
    }

    memcpy(&s_fileBuffer[s_fileSize], text, copyLen);
    s_fileSize += copyLen;
    s_fileBuffer[s_fileSize] = '\0';
}

void DebugUART::saveToHostFile() {
#if defined(DEBUGUART_SAVE_TO_FILE)
    FILE* f = fopen("debug.txt", "w");
    if (f == nullptr) {
        return;
    }
    fwrite(s_fileBuffer, 1, s_fileSize, f);
    fclose(f);
#endif
}
